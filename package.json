{
  "name": "mini-driving-simulator-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Mini Driving Simulator 3D",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lianeheidemann.minidrivingsimulator3d",
    "productName": "Mini Driving Simulator 3D",
    "files": [
      "index.html",
      "main.js",
      "src/**/*",
      "input/**/*",
      "media/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "MiniDrivingSimulator3D.exe"
    }
  }
}
